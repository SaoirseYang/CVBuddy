{
  "manifest_version": 3,
  "name": "自维护网申助手",
  "version": "0.5.1",
  "description": "可自维护的网申自动填写助手：分段表单循环填写、时序策略自适应、可视词典与站点规则、本地桥接直连 WorkBuddy",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "自维护网申助手"
  },
  "background": {
    "service_worker": "src/background/index.js"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "src/shared/dictionary.js",
        "src/shared/storage.js",
        "src/shared/builtin-rules.js",
        "src/content/scanner.js",
        "src/content/filler.js",
        "src/content/strategy.js",
        "src/content/teach.js",
        "src/content/controller.js",
        "src/content/bridge.js",
        "src/content/hud.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
